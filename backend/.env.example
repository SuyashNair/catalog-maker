# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.mongodb.net/catalog-maker

# JWT
JWT_SECRET=your-secret-key-here
JWT_EXPIRE=7d

# Admin Credentials (seeded)
ADMIN_EMAIL=admin@catalogmaker.com
ADMIN_PASSWORD=admin123

# Shopify (Optional - demo data seeder works without these)
SHOPIFY_STORE_URL=
SHOPIFY_ACCESS_TOKEN=

# WooCommerce (Optional - demo data seeder works without these)
WOOCOMMERCE_URL=
WOOCOMMERCE_KEY=
WOOCOMMERCE_SECRET=
